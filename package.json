{
  "name": "catalogify-impl",
  "version": "1.0.0",
  "main": "index.ts",
  "packageManager": "pnpm@11.1.1",
  "dependencies": {
    "@react-navigation/native": "^7.3.8",
    "@react-navigation/native-stack": "^7.17.10",
    "expo": "~57.0.4",
    "expo-auth-session": "~57.0.2",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.0",
    "expo-image-manipulator": "~57.0.2",
    "expo-image-picker": "~57.0.2",
    "expo-linking": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "firebase": "^12.16.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "firebase-tools": "^15.23.0",
    "jest-expo": "^57.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --selectProjects app",
    "test:emulator": "firebase emulators:exec --only firestore,auth \"jest --selectProjects emulator --forceExit\""
  },
  "private": true,
  "jest": {
    "projects": [
      {
        "displayName": "app",
        "preset": "jest-expo",
        "testPathIgnorePatterns": [
          "/node_modules/",
          "<rootDir>/src/services/FirebaseCatalogRepository.test.ts"
        ]
      },
      {
        "displayName": "emulator",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/src/services/FirebaseCatalogRepository.test.ts"
        ],
        "transform": {
          "\\.[jt]sx?$": [
            "babel-jest",
            { "presets": ["expo/internal/babel-preset.js"] }
          ]
        },
        "transformIgnorePatterns": [
          "/node_modules/(?!(firebase|@firebase|expo))"
        ],
        "moduleNameMapper": {
          "^expo-image-manipulator$": "<rootDir>/src/services/__mocks__/expo-image-manipulator.js"
        },
        "setupFiles": [
          "<rootDir>/jest.setup.js"
        ]
      }
    ]
  }
}
