{
  "name": "catalogify",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/native": "^7.3.8",
    "@react-navigation/native-stack": "^7.17.10",
    "@supabase/supabase-js": "^2.110.3",
    "expo": "~57.0.4",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.0",
    "expo-font": "~57.0.1",
    "expo-image-manipulator": "~57.0.2",
    "expo-image-picker": "~57.0.2",
    "expo-linking": "~57.0.2",
    "expo-notifications": "~57.0.7",
    "expo-status-bar": "~57.0.0",
    "firebase": "^12.16.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "firebase-tools": "^15.23.0",
    "jest-expo": "^57.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --selectProjects app",
    "test:emulator": "firebase emulators:exec --only firestore,auth \"jest --selectProjects emulator --forceExit\""
  },
  "private": true,
  "jest": {
    "projects": [
      {
        "displayName": "app",
        "preset": "jest-expo",
        "testPathIgnorePatterns": [
          "/node_modules/",
          "<rootDir>/src/services/FirebaseCatalogRepository.test.ts"
        ]
      },
      {
        "displayName": "emulator",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/src/services/FirebaseCatalogRepository.test.ts"
        ],
        "transform": {
          "\\.[jt]sx?$": [
            "babel-jest",
            {
              "presets": [
                "expo/internal/babel-preset.js"
              ]
            }
          ]
        },
        "transformIgnorePatterns": [
          "/node_modules/(?!(firebase|@firebase|expo))"
        ],
        "moduleNameMapper": {
          "^expo-image-manipulator$": "<rootDir>/src/services/__mocks__/expo-image-manipulator.js"
        },
        "setupFiles": [
          "<rootDir>/jest.setup.js"
        ]
      }
    ]
  }
}
